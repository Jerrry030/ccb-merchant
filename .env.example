# Node 24.15+ / 24.x. Localhost is intentionally the default.
HOST=127.0.0.1
PORT=8787
# Optional for localhost; REQUIRED together with ALLOW_REMOTE=true for network operation.
# Use an HTTPS origin for a remote host. No path, query, or credentials.
PUBLIC_ORIGIN=http://localhost:8787
ALLOW_REMOTE=false
DATA_DIR=./data
SITE_NAME=CCB Merchant

# Set BOTH or neither. With both empty the admin upstream wizard is available.
# Direct provider can be the private core OR the immediate parent merchant site.
# Use this site's own service ccbm_ key, NEVER a platform-admin or parent-site key.
UPSTREAM_URL=
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_MS=15000
# Wizard: private/HTTP targets require exact origins explicitly approved by operator.
# Environment UPSTREAM_URL is itself an explicit approval. Never allow metadata services.
# Example: http://127.0.0.1:8080,https://parent.internal:8443
UPSTREAM_ALLOWED_ORIGINS=
# Model/traffic wait for response headers only; no whole-stream timer.
# Disconnects cancel upstream; requests are never automatically replayed.
RUNTIME_HEADER_TIMEOUT_MS=600000
RUNTIME_BODY_LIMIT=33554432
# Concurrency is not the allocated customer capacity. Load-test before increasing.
RUNTIME_MAX_IN_FLIGHT=8
# Durable customer/payment/fulfillment reconciliation, milliseconds (1000..300000).
RECONCILE_INTERVAL_MS=10000

# Optional deployment lock. If SMTP_HOST and SMTP_FROM are set, they override the
# admin UI and cannot be changed in the browser. Leave them empty to configure
# mail under Site settings. STARTTLS is mandatory on non-465 ports; 465 uses TLS.
# A trusted TLS SMTP relay may omit SMTP_USER/SMTP_PASSWORD; otherwise set both.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional deployment lock. Set BOTH to manage Stripe outside the admin UI.
# Leave both empty to enter the secret and webhook signing secret under Site settings.
# Use matching test/live credentials. Do not commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Initial defaults for a new payment configuration; later changes use the admin UI.
PAYMENT_MIN_MINOR=100
PAYMENT_MAX_MINOR=1000000
# Alipay, WeChat Native, EasyPay, SuixingPay and Airwallex are configured in Site settings.
# Enable the channel and select its storefront source. Use an externally reachable HTTPS PUBLIC_ORIGIN.
# Back up DATA_DIR/payment.key together with SQLite; it encrypts immutable order snapshots.

# Local homepage sample only. Never enable for a real site.
HOME_PREVIEW_SAMPLE=false
