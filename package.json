{
  "name": "ccb-merchant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test tests/server/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "check:security": "node scripts/check-repository.mjs",
    "test:security": "node --test tests/security/*.test.js",
    "test:proxy": "node --test tests/proxy/*.test.js"
  },
  "dependencies": {
    "@airwallex/components-sdk": "1.36.0",
    "nodemailer": "10.2.1",
    "qrcode": "1.5.4"
  }
}
